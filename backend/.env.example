DB_HOST=your-azure-postgresql-host
DB_PORT=5432
DB_NAME=mine_manager_ai
DB_USER=your-database-user
DB_PASSWORD=your-database-password

SECRET_KEY=generate-a-secure-random-secret
OPENAI_API_KEY=your-openai-api-key
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
ENVIRONMENT=development

APP_VERSION=1.0.4
APP_NAME=Mine Manager AI
APP_ENV=development
STORAGE_PATH=app/storage

LOG_DIR=logs
LOG_LEVEL=INFO
UPLOAD_DIR=uploads
DEBUG=false

# Public lead notification (disabled by default for local/test environments)
# Requires a single-tenant Microsoft Entra app with Microsoft Graph Mail.Send
# application permission and tenant admin consent. Store the client secret only
# in the backend deployment environment.
LEAD_NOTIFICATION_ENABLED=false
LEAD_NOTIFICATION_TO=bayarbat.b@minemanager.ai
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER=
MS_GRAPH_TIMEOUT_SECONDS=8
